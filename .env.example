# =====================================================================
# Invoice Keeper — пример конфигурации.  cp .env.example .env
# Здесь нет реальных секретов: перед реальным использованием смените
# ADMIN_PASSWORD, SECRET_KEY и пароли БД.
# =====================================================================

# --- Администратор (синхронизируется в БД при каждом старте api) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin

# Секрет для хеширования токенов сессий (минимум 16 символов)
SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL (контейнер db) ---
POSTGRES_USER=invoice
POSTGRES_PASSWORD=invoice
POSTGRES_DB=invoice_keeper
# DATABASE_URL собирается в docker-compose.yml из переменных выше.
# Для запуска вне Docker задайте его явно:
# DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoice_keeper

# Порт панели на хосте: http://localhost:8000
APP_PORT=8000

# --- Время ---
# Единый часовой пояс: «сегодня» считается в нём
APP_TIMEZONE=Europe/Moscow
# Демо-инструмент: подменяет «сегодня» (YYYY-MM-DD). Пусто = выключено.
APP_FAKE_TODAY=

# --- Напоминания ---
# За сколько дней до срока напоминать (минимум 3)
REMINDER_DAYS_BEFORE=3
# Интервал фоновой проверки worker, секунд
WORKER_INTERVAL_SECONDS=60
# Повторное напоминание о просрочке раз в N дней (0 — выключено) и не больше M раз
OVERDUE_REMIND_EVERY_DAYS=3
OVERDUE_REMIND_MAX=5
# Попыток доставки до статуса dead
DELIVERY_MAX_ATTEMPTS=5

# --- Telegram ---
# Токен от @BotFather. Пусто = режим «лог вместо отправки» (сообщения пишутся в лог worker)
TELEGRAM_BOT_TOKEN=
# chat_id группы/канала/лички, куда слать напоминания (группы — отрицательное число)
TELEGRAM_CHAT_ID=
# Приём нажатий inline-кнопок (long polling в worker)
TELEGRAM_POLLING_ENABLED=true

# --- Email-оповещения (SMTP). Пусто = канал выключен ---
# Для демо: docker compose --profile demo-mail up -d, затем
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_SECURITY=none   (письма — http://localhost:8025)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_FROM=Invoice Keeper <invoice-keeper@example.com>
# Общий список получателей через запятую
EMAIL_RECIPIENTS=
# Дополнительно слать на email из профилей пользователей
EMAIL_TO_USERS=true

# --- Чат-вебхук: Slack / Discord / Mattermost incoming webhook. Пусто = выключен ---
CHAT_WEBHOOK_URL=
# auto (по хосту) | slack | discord | mattermost
CHAT_WEBHOOK_FORMAT=auto

# --- Вебхуки ---
# true — разрешить loopback/private/link-local адреса (только для локального демо!)
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_TIMEOUT_SECONDS=10

# --- Сессии и безопасность ---
# true, если панель открыта по HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Ограничение попыток входа: не больше N неудачных попыток за окно (сек) с одного IP на логин
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Демо-данные ---
# Идемпотентный сид при старте (аренда RUB, сервер USD, подписка EUR, 2 пользователя)
SEED_ON_START=true
# Пароль демо-пользователей ivan и maria
SEED_USER_PASSWORD=user12345

LOG_LEVEL=INFO
